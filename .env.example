# Copy to .env and edit. Everything is optional: the app works with none of this set.

# Password for the web UI. Strongly recommended if you ever expose the app beyond this phone.
# Leave empty only while it listens on 127.0.0.1 (the default).
APP_PASSWORD=

# Where the database, uploads and rendered clips are stored.
DATA_DIR=data

# Shown on invoices and in drafted messages.
BUSINESS_NAME=My Video Clipping Studio
# Free text printed on invoices (bank / Easypaisa / JazzCash / PayPal details...).
PAYMENT_INSTRUCTIONS=

# Extra folders videos may be imported from (separated by ':' ). ~/storage/* is allowed automatically after termux-setup-storage.
IMPORT_DIRS=

# Limits
MAX_UPLOAD_MB=4096
MAX_DOWNLOAD_MB=2048

# Scan your feeds automatically every N minutes while the app is running (0 = only when you press "Scan feeds").
SCAN_INTERVAL_MINUTES=0

# --- Optional: sending approved messages / deliveries by email through YOUR OWN mailbox (free with Gmail app passwords etc.)
# Without these, approved messages are copied and sent by you manually.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=false

# --- Optional: automatic payment records from YOUR OWN Stripe account (needs a public HTTPS URL to /webhooks/stripe)
STRIPE_WEBHOOK_SECRET=
